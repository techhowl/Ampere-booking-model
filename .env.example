# --- database (DigitalOcean Managed Postgres) ---
DATABASE_URL="postgresql://user:pass@db-host:25060/ampere_buy?sslmode=require"

# --- identity / PII ---
# Encrypts the phone number at rest. Generate: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=""
# Builds the searchable phone_hash. Different value from the one above.
PHONE_HMAC_SECRET=""

# --- session ---
SESSION_SECRET=""

# Keys the stored OTP hash. A six-digit code is trivially reversible from an
# unkeyed hash. Generate: openssl rand -base64 32
OTP_HASH_SECRET=""

# --- juspay ---
# Leave JUSPAY_ENABLED false until ALL of the following are true:
#   1. the webhook signature scheme is confirmed by Juspay
#   2. the Order Status API response shape is confirmed
#   3. sandbox credentials below are filled in and tested
# Until then FakeJuspayClient drives the whole flow, including reconciliation.
JUSPAY_ENABLED="false"
JUSPAY_MERCHANT_ID=""
JUSPAY_API_KEY=""
JUSPAY_PAYMENT_PAGE_CLIENT_ID=""
JUSPAY_WEBHOOK_SECRET=""
# Absolute and publicly reachable — Juspay's servers must be able to call it.
JUSPAY_WEBHOOK_URL="https://buy.ampere-electric.com/api/webhooks/juspay"
JUSPAY_BASE_URL="https://sandbox.juspay.in"

# --- messaging ---
SMS_PROVIDER_KEY=""
WHATSAPP_BSP_TOKEN=""

# --- attribution ---
# Set cookies on the PARENT domain so they are shared with the main site.
COOKIE_DOMAIN=".ampere-electric.com"
NEXT_PUBLIC_META_PIXEL_ID="505579163311452"
META_CAPI_TOKEN=""
NEXT_PUBLIC_GA4_ID=""

# --- bot defence ---
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- admin ---
ADMIN_PASSWORD_HASH=""

# --- errors ---
SENTRY_DSN=""
