# --- database (DigitalOcean Managed Postgres) ---
DATABASE_URL="postgresql://user:pass@db-host:25060/ampere_buy?sslmode=require"

# --- identity / PII ---
# Encrypts the phone number at rest. Generate: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=""
# Builds the searchable phone_hash. Different value from the one above.
PHONE_HMAC_SECRET=""

# --- session ---
SESSION_SECRET=""
# Buy Now (price, payment, Juspay). Off unless "true": launch is test rides only.
BUY_NOW_ENABLED="false"

# Minutes without activity before a journey times out: a refresh stops resuming
# it, and booking or paying needs the OTP again. Default 60.
SESSION_IDLE_MINUTES="60"

# Keys the stored OTP hash. A six-digit code is trivially reversible from an
# unkeyed hash. Generate: openssl rand -base64 32
OTP_HASH_SECRET=""

# --- juspay ---
# Leave JUSPAY_ENABLED false until every value below is filled in and a
# sandbox session call has actually succeeded. Until then FakeJuspayClient
# drives the whole flow, including reconciliation.
JUSPAY_ENABLED="false"

# Merchant ID and payment page client ID come from Juspay (welcome email).
JUSPAY_MERCHANT_ID=""
JUSPAY_PAYMENT_PAGE_CLIENT_ID=""

# Self-service: Dashboard > Payments > Settings > Security > Create New API Key.
# Sent as HTTP Basic with the key as USERNAME and an EMPTY password.
JUSPAY_API_KEY=""

# Juspay authenticates webhooks with Basic auth, not a signature. Set the same
# pair at Dashboard > Payments > Settings > Webhook. The username may not
# contain  @!#$%&'*+-/=?^_.{|}~  . Generate the password: openssl rand -hex 32
JUSPAY_WEBHOOK_USERNAME=""
JUSPAY_WEBHOOK_PASSWORD=""

# Absolute, HTTPS, publicly reachable — Juspay's servers must be able to call
# it. For local testing use a tunnel (cloudflared / ngrok) and put that here.
JUSPAY_WEBHOOK_URL="https://buy.ampere-electric.com/api/webhooks/juspay"

# https://sandbox.juspay.in for testing, https://api.juspay.in for live.
JUSPAY_BASE_URL="https://sandbox.juspay.in"

# Juspay requires customer_email; our form does not collect one, so orders are
# sent a synthetic address at this domain. Point it at a real inbox only if
# Ampere wants Juspay's receipts to land somewhere.
JUSPAY_RECEIPT_DOMAIN="orders.ampere-electric.com"

# --- messaging ---
SMS_PROVIDER_KEY=""
WHATSAPP_BSP_TOKEN=""

# --- attribution ---
# Set cookies on the PARENT domain so they are shared with the main site.
COOKIE_DOMAIN=".ampere-electric.com"
NEXT_PUBLIC_META_PIXEL_ID="505579163311452"
META_CAPI_TOKEN=""
NEXT_PUBLIC_GA4_ID=""

# --- bot defence ---
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- admin ---
# SHA-256 hex of a RANDOM token, not of a password someone chose: the hash is
# fast, so only a random secret makes a leaked hash worthless.
#   TOKEN=$(openssl rand -base64 32)          # give this to whoever exports
#   printf %s "$TOKEN" | sha256sum | cut -d' ' -f1   # put this here
# Unset means the admin export is closed.
ADMIN_PASSWORD_HASH=""
# Optional. Comma-separated client IPs allowed to call /api/admin/* at all
# (the call centre's office, say). Unset means any address, as before. Every
# address also gets 30 attempts an hour.
ADMIN_ALLOWED_IPS=""

# --- Greaves CRM.Next (Zoho CRM) — docs/greaves-crm/README.md ---
# fake (default): nothing leaves this machine. zoho: verified leads and booked
# test rides go to Greaves' CRM. Outside production ZOHO_API_URL MUST be the
# sandbox, and in production it must not be — the app refuses to start otherwise.
# The values come from Greaves' Postman collection. Never commit them.
# Locally and on UAT: the SANDBOX collection. The LIVE one (www.zohoapis.in)
# belongs only in the droplet's deploy/.env.production.
CRM_PROVIDER="fake"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
ZOHO_API_URL="https://sandbox.zohoapis.in"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
# Greaves' function names, if they ever rename one. Defaults shown.
# ZOHO_DEALERS_FUNCTION="get_dealers"
# ZOHO_PRODUCTS_FUNCTION="get_products"

# --- Zoho pilot (from 2026-11-23) ---
# Greaves CRM account ids of the only dealers the page offers, comma
# separated. Unset: every active dealer. Ids differ between sandbox and live.
PILOT_DEALER_CRM_IDS=""
# Where a customer goes when no dealer we offer is near their pincode: the
# Goal App test ride form. Unset: the "no dealership in your area" screen.
# With PILOT_DEALER_CRM_IDS set too, /buy asks the pincode first (a popup)
# and redirects those customers here before they give any details.
GOAL_APP_URL=""

# --- OTP ---
# "false" switches the OTP off: step one saves the lead and the journey goes
# on, and unverified leads go to the CRM (Greaves' call centre qualifies them).
# For production while the SMS sender awaits DLT. Anything else: required.
# The app refuses to start with this off and BUY_NOW_ENABLED on.
OTP_REQUIRED="true"

# --- errors ---
SENTRY_DSN=""

# --- scheduled jobs ---
# Shared secret for POST /api/cron/expire-reservations and /api/cron/crm-sync.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# --- deployment ---
# development | uat | production. Defaults to production when unset.
APP_ENV="development"
# Show the OTP on screen instead of sending it. UAT only; the app refuses to
# start if this is set while APP_ENV is production.
OTP_ECHO_ENABLED="true"
