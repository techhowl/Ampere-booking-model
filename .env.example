# --- database (DigitalOcean Managed Postgres) ---
DATABASE_URL="postgresql://user:pass@db-host:25060/ampere_buy?sslmode=require"

# --- identity / PII ---
# Encrypts the phone number at rest. Generate: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=""
# Builds the searchable phone_hash. Different value from the one above.
PHONE_HMAC_SECRET=""

# --- session ---
SESSION_SECRET=""

# Keys the stored OTP hash. A six-digit code is trivially reversible from an
# unkeyed hash. Generate: openssl rand -base64 32
OTP_HASH_SECRET=""

# --- juspay ---
# Leave JUSPAY_ENABLED false until every value below is filled in and a
# sandbox session call has actually succeeded. Until then FakeJuspayClient
# drives the whole flow, including reconciliation.
JUSPAY_ENABLED="false"

# Merchant ID and payment page client ID come from Juspay (welcome email).
JUSPAY_MERCHANT_ID=""
JUSPAY_PAYMENT_PAGE_CLIENT_ID=""

# Self-service: Dashboard > Payments > Settings > Security > Create New API Key.
# Sent as HTTP Basic with the key as USERNAME and an EMPTY password.
JUSPAY_API_KEY=""

# Juspay authenticates webhooks with Basic auth, not a signature. Set the same
# pair at Dashboard > Payments > Settings > Webhook. The username may not
# contain  @!#$%&'*+-/=?^_.{|}~  . Generate the password: openssl rand -hex 32
JUSPAY_WEBHOOK_USERNAME=""
JUSPAY_WEBHOOK_PASSWORD=""

# Absolute, HTTPS, publicly reachable — Juspay's servers must be able to call
# it. For local testing use a tunnel (cloudflared / ngrok) and put that here.
JUSPAY_WEBHOOK_URL="https://buy.ampere-electric.com/api/webhooks/juspay"

# https://sandbox.juspay.in for testing, https://api.juspay.in for live.
JUSPAY_BASE_URL="https://sandbox.juspay.in"

# Juspay requires customer_email; our form does not collect one, so orders are
# sent a synthetic address at this domain. Point it at a real inbox only if
# Ampere wants Juspay's receipts to land somewhere.
JUSPAY_RECEIPT_DOMAIN="orders.ampere-electric.com"

# --- messaging ---
SMS_PROVIDER_KEY=""
WHATSAPP_BSP_TOKEN=""

# --- attribution ---
# Set cookies on the PARENT domain so they are shared with the main site.
COOKIE_DOMAIN=".ampere-electric.com"
NEXT_PUBLIC_META_PIXEL_ID="505579163311452"
META_CAPI_TOKEN=""
NEXT_PUBLIC_GA4_ID=""

# --- bot defence ---
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- admin ---
ADMIN_PASSWORD_HASH=""

# --- errors ---
SENTRY_DSN=""

# --- scheduled jobs ---
# Shared secret for POST /api/cron/expire-reservations.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# --- deployment ---
# development | uat | production. Defaults to production when unset.
APP_ENV="development"
# Show the OTP on screen instead of sending it. UAT only; the app refuses to
# start if this is set while APP_ENV is production.
OTP_ECHO_ENABLED="true"
